# Copy to .env for local development. Never commit the copied file.
DEPLOYMENT_MODE=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-server-side-supabase-key
TEKK_API_KEY_PEPPER=generate-a-long-random-secret

TEKK_LLM_PROVIDER=gemini
TEKK_LLM_MODEL=gemini-2.0-flash
TEKK_LLM_GEMINI_API_KEY=your-gemini-api-key
TEKK_LLM_MAX_TOKENS=8000

SEARXNG_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379/0
TEKK_REDIS_STREAM_ENABLED=true

TEKK_CORS_ORIGINS=http://localhost:3000
TEKK_STREAM_QUEUE_SIZE=1000
TEKK_SEARCH_MAX_RESULTS=50
TEKK_SCRAPE_MAX_SOURCES=20
TEKK_SCRAPE_TIMEOUT_SECONDS=8
